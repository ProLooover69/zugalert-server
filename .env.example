# ── ZugAlert Backend – Environment ──
# Lokal: Datei nach .env kopieren und Werte eintragen.
# Railway: dieselben Variablen im Dashboard unter "Variables" setzen (KEINE .env committen!).

# Port – Railway setzt PORT automatisch, lokal Standard 3001
PORT=3001

# MongoDB – ERFORDERLICH für Auth & gespeicherte Routen
# MongoDB Atlas: https://cloud.mongodb.com  → Connection String hier einsetzen.
# Ohne gültige URL startet der Server zwar, aber /api/auth und /api/users schlagen fehl.
MONGODB_URI=mongodb+srv://USER:PASSWORT@cluster0.xxxxx.mongodb.net/zugalert?retryWrites=true&w=majority

# JWT Secret – ERFORDERLICH für Auth (langer Zufallsstring, z. B. `openssl rand -hex 32`)
JWT_SECRET=bitte_durch_langen_zufallsstring_ersetzen

# Redis – OPTIONAL (ohne läuft der In-Memory-Cache)
# REDIS_URL=redis://localhost:6379
