# ── ZugAlert Backend (Bahn-Daten-Proxy) – Environment ──
# Lokal: Datei nach .env kopieren. Produktion (Vercel): dieselben Variablen
# unter Project → Settings → Environment Variables setzen (KEINE .env committen!).

# Port – lokal Standard 3001 (Vercel/Render setzen PORT automatisch)
PORT=3001

# ── Datenquelle ──
# Profil für Suche/Verbindungen (No-Auth): dbweb (Standard) oder dbnav.
# DB_PROFILE=dbweb

# DB API Marketplace – NUR für Abfahrten/Störungen (Profil dbris → RIS::Boards).
# Funktioniert von Cloud-IPs (Vercel), wo dbweb/dbnav geblockt werden (403).
# Voraussetzung: DB-App auf https://developers.deutschebahn.com auf "RIS::Boards" abonnieren.
# Ohne diese Werte werden Abfahrten über dbweb/db-rest versucht (nur von Wohn-IP zuverlässig).
# DB_CLIENT_ID=dein_db_client_id
# DB_API_KEY=dein_db_api_key

# db-rest-Fallback-Instanzen (kommagetrennt) für Verbindungen/Abfahrten.
# DB_REST_URLS=https://v6.db.transport.rest,https://v5.db.transport.rest

# CORS – Standard offen (öffentliche Read-only-Daten). Optional einschränken:
# CORS_ORIGIN=https://zugalert-server.vercel.app
